# Neon Postgres connection string (Vercel → Storage → Neon adds this automatically)
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Groq API key for reading emails into tasks (free at console.groq.com/keys)
GROQ_API_KEY=
# Optional: override the Groq model
GROQ_MODEL=llama-3.3-70b-versatile

# Optional alternative: Claude API key (used only if GROQ_API_KEY is empty)
ANTHROPIC_API_KEY=

# Passcode to open the app (keeps your data private on a public URL)
APP_PASSWORD=change-me
