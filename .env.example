# Neon Postgres connection string (Vercel → Storage → Neon adds this automatically)
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Claude API key for reading emails into tasks (console.anthropic.com)
ANTHROPIC_API_KEY=

# Optional: override the model used for email extraction
ANTHROPIC_MODEL=claude-sonnet-5-5

# Passcode to open the app (keeps your data private on a public URL)
APP_PASSWORD=change-me
